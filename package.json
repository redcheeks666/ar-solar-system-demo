{
  "name": "ar-solar-system-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:gesture": "vitest run tests/gesture",
    "verify:m5.5": "node scripts/run-m5_5-verification.mjs",
    "sync:agent": "node scripts/sync-agent-repo.mjs",
    "sync:agent:commit": "node scripts/sync-agent-repo.mjs --commit-agent",
    "sync:agent:push": "node scripts/sync-agent-repo.mjs --commit-agent --push"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
